{
    "name": "mediamouse/users",
    "description": "Add user management to filament laravel",
    "type": "library",
    "repositories": [
        {
            "type": "vcs",
            "url": "ssh://repos@repos.mediamouse.nl:22/home/repos/repos/mediamouse.filament.git"
        },
        {
            "type": "vcs",
            "url": "ssh://repos@repos.mediamouse.nl:22/home/repos/repos/mediamouse.laravel.git"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^9.0|^10.0|^11.0|^12.0",
        "filament/filament": "^4.0",
        "filament/forms": "^4.0",
        "filament/spatie-laravel-settings-plugin": "^4.0",
        "mediamouse/laravel": "dev-laravel-11",
        "mediamouse/filament": "dev-filament-4",
        "spatie/laravel-package-tools": "^1.9"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.7"
    },
    "license": "private",
    "autoload": {
        "psr-4": {
            "Mediamouse\\Users\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Mediamouse\\Users\\Tests\\": "tests"
        }
    },
    "authors": [
        {
            "name": "Jeroen de Leur",
            "email": "jeroen@mediamouse.nl"
        },
        {
            "name": "Sjoerd Steeman",
            "email": "sjoerd@mediamouse.nl"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Mediamouse\\Users\\UserServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
